# Copy these fields into framework/.env. Never put real credentials in this template.
QQ_APP_ID_A=your-qq-app-id-a
QQ_APP_SECRET_A=your-qq-app-secret-a
QQ_APP_ID_B=your-qq-app-id-b
QQ_APP_SECRET_B=your-qq-app-secret-b

# A NEW dedicated acceptance database. Retired TEST_DATABASE_* values are not read.
# Hostname or IP only: no http:// prefix, path or port.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=dou_bot_test
DATABASE_NAME=dou_bot_test
DATABASE_PASSWORD=your-database-password
# Lowercase letters, digits and underscores; start with a letter or underscore, at most 63 characters.
DATABASE_SCHEMA=dou_bot_acceptance
DATABASE_SSL=false

PROBE_TIMEOUT_MS=900000
